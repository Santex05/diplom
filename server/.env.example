# Путь к папке с аниме (относительно server/ или абсолютный)
# Локально без Docker (опционально):
# ANIME_DIR=../anime
# В Docker задаётся автоматически: /data/anime

# Сжатие серий при загрузке (нужен ffmpeg). В Docker включено по умолчанию.
# VIDEO_TRANSCODE=1
# FFMPEG_CRF=28
# FFMPEG_PRESET=medium

# Порт сервера
PORT=3001

# PostgreSQL (Docker: postgres://anicatalog:anicatalog@db:5432/anicatalog)
DATABASE_URL=postgres://anicatalog:anicatalog@localhost:5432/anicatalog

# Учётные данные админ-панели (отдельно от пользователей сайта)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me
